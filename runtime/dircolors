# Configuration file for dircolors, a utility to help you set the LS_COLORS
# environment variable for use with `ls --color=auto`.
#
# ubuntu:24.04's coreutils ships an EMPTY compiled-in database for
# `dircolors -b`, which makes ~/.bashrc set LS_COLORS='' and disables ls
# coloring. The entrypoint seeds this file as ~/.dircolors (the skel .bashrc
# prefers it over the empty built-in), restoring directory/file colors.

# Global defaults
NORMAL 00
FILE 00
DIR 01;34
LINK 01;36
FIFO 40;33
SOCK 01;35
DOOR 01;35
BLK 40;33;01
CHR 40;33;01
